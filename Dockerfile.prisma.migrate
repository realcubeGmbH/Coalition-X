FROM node:22-alpine

WORKDIR /app

# Copy package files and prisma directory
COPY package*.json ./
COPY prisma ./prisma/

# Install app dependencies
RUN npm ci

# Generate prisma client (using custom config)
# Provide a dummy DATABASE_URL for generate (actual URL comes from env at runtime)
ENV DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy"
RUN npx prisma generate --config prisma/prisma.config.ts

# Run migrations, then seed the schema registry. Migrations create the
# schema_registries *table*; the seed puts the V0.9.2 row in it — without that,
# any submission naming its schema version explicitly fails SCHEMA_NOT_FOUND.
# Both steps are idempotent, and the process still exits when they finish.
CMD ["sh", "-c", "npx prisma migrate deploy --config prisma/prisma.config.ts && node prisma/seed.mjs"]

