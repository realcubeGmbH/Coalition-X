# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variables (contains secrets)
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example

# Saved plan files (contain the full resource diff, incl. secret values)
*.tfplan
tfplan
plan.out

# Terraform CLI config (may contain credentials)
.terraformrc
terraform.rc

# Terraform directory
.terraform/

# NOTE: .terraform.lock.hcl is intentionally NOT ignored — commit it so
# provider versions are pinned and reproducible across the team.

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# AWS credentials (should never be committed)
.aws/
*.pem
*.key

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.idea/
.vscode/
